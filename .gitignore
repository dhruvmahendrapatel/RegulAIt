# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
backend.hcl
tfplan*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# AWS / secrets
.aws/
*.pem
*.key
credentials
.env
.env.*

# graphify (regenerable build artifact — local AST, zero cost to rebuild)
graphify-out/

# Node
node_modules/
dist/
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
*.swp

# agent worktrees (session tooling, never source)
.claude/worktrees/
infra/modules/*/.terraform.lock.hcl

# Runtime WORM anchor artifacts (ADR-0060). Written by the default
# LocalWormSink into DEFAULT_ANCHOR_DIR on every local run since anchoring
# became default-ON. They are machine-local tamper-evidence records: an
# anchor stored inside the very repo it attests to, where any commit can
# rewrite it, proves nothing — and it collides across machines.
audit-anchors/

# Generated by `pnpm --filter @regulait/gateway demo:setup` — evidence for the
# MCP-discovery demo. Regenerated on every run; never a source artifact.
demo-mcp-evidence.log

# Generated by `demo:setup` — an EPHEMERAL demo license keyring. The private
# half is never written anywhere; this holds only the public key, and it is
# regenerated on every run. Never a source artifact, never a release key.
demo-license-keys/

# Generated by the web e2e global-setup — an EPHEMERAL license keyring. Only
# the PUBLIC half is written; the private half is never persisted anywhere.
# Regenerated on every run. Never a source artifact, never a release key.
apps/web/e2e/.e2e-license-keys/

# real seeded-DB journey screenshots (apps/web/e2e/demo-intake.spec.ts): ~11 MB per
# run, regenerated every run — kept out of history; the mocked set is tracked
apps/web/e2e/artifacts/demo/real-*.png
apps/web/e2e/artifacts/demo/real-gate.txt
apps/web/e2e/artifacts/demo/fallback-deck.html
