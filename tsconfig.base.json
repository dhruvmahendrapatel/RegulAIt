{
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    // beside the output, so deleting dist/ also forgets the build state (a stale .tsbuildinfo beside tsconfig.json
    // makes tsc skip the emit and leaves dist/ empty)
    "tsBuildInfoFile": "${configDir}/dist/tsconfig.tsbuildinfo",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  }
}
