#!/bin/bash
# Boot script: docker + compose plugin, optional swap, pull the source bundle
# from S3 (waiting for it if the upload hasn't happened yet), generate fresh
# runtime secrets, compose up. Progress + errors land in /var/log/app-boot.log.
set -uxo pipefail
exec >> /var/log/app-boot.log 2>&1

dnf install -y docker
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -sSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

if [ "${swap_gb}" -gt 0 ]; then
  fallocate -l "${swap_gb}G" /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
fi

mkdir -p /opt/app
cd /opt/app

# The tarball is uploaded right after `terraform apply` — poll for up to 30 min.
for i in $(seq 1 180); do
  if aws s3 cp "s3://${bucket}/${object_key}" /opt/app/source.tar.gz; then
    break
  fi
  sleep 10
done
[ -f /opt/app/source.tar.gz ] || { echo "source bundle never arrived"; exit 1; }

tar xzf source.tar.gz

# Fresh secrets per deployment — never the dev defaults from the compose file.
DATA_KEY=$(openssl rand -hex 32)
BOOT_TOKEN=$(openssl rand -hex 24)
cat > docker-compose.override.yml <<EOF
services:
  gateway:
    environment:
      REGULAIT_DATA_KEY: $${DATA_KEY}
      REGULAIT_BOOTSTRAP_TOKEN: $${BOOT_TOKEN}
      # ADR-0181: the gateway's HSTS default is one year. This box serves an
      # sslip.io name derived from an EC2 public IP that changes on stop/start,
      # and a browser cannot be told to forget a pin before max-age runs out,
      # so the dev box keeps the bounded one-day value (ADR-0029 amendment).
      REGULAIT_HSTS: max-age=86400
    restart: unless-stopped
  db:
    restart: unless-stopped
EOF

# --- on-box TLS (ADR-0029) ----------------------------------------------------
# Caddy terminates TLS in the compose stack and gets a real Let's Encrypt
# certificate for an sslip.io hostname derived from THIS instance's public IP —
# sslip.io resolves `a-b-c-d.sslip.io` to a.b.c.d, so no domain, no Route53, no
# ACM, no ALB, and no new AWS cost. The IP is read from IMDSv2 at boot rather
# than passed in from Terraform, which would be a create-time cycle (the public
# IP does not exist until the instance does).
COMPOSE_PROFILE_ARGS=""
%{ if enable_onbox_tls ~}
IMDS_TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
PUBLIC_IP=$(curl -sS -H "X-aws-ec2-metadata-token: $${IMDS_TOKEN}" \
  "http://169.254.169.254/latest/meta-data/public-ipv4")
if [ -n "$${PUBLIC_IP}" ]; then
  TLS_HOST="$(echo "$${PUBLIC_IP}" | tr '.' '-').sslip.io"
  cat >> docker-compose.override.yml <<EOF
  caddy:
    environment:
      REGULAIT_TLS_HOST: $${TLS_HOST}
EOF
  COMPOSE_PROFILE_ARGS="--profile tls"
  echo "app-boot: on-box TLS enabled for $${TLS_HOST}"
else
  # Fail LOUD rather than silently serving plaintext: without a public IP there
  # is no resolvable hostname, so ACME cannot succeed.
  echo "app-boot: FATAL no public IPv4 from IMDS; refusing to start without TLS"
  exit 1
fi
%{ endif ~}

docker compose $${COMPOSE_PROFILE_ARGS} up -d --build
echo "app-boot: compose up returned $?"
