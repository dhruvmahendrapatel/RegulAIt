output "instance_id" {
  description = "For `aws ssm start-session --target`."
  value       = module.app.instance_id
}

output "source_bucket" {
  description = "Where the owner uploads the git archive of the commit to deploy."
  value       = module.app.source_bucket
}

output "kms_key_alias" {
  description = "Pass to `aws ssm put-parameter --key-id` for every SecureString (DEMO_RUNBOOK §8.5)."
  value       = aws_kms_alias.host.name
}

output "ssm_prefix" {
  value = local.ssm_prefix
}

output "ingress_rule_count" {
  description = "Must be 0."
  value       = module.app.ingress_rule_count
}

output "data_volume_id" {
  value = module.app.data_volume_id
}

output "log_group" {
  value = aws_cloudwatch_log_group.containers.name
}

output "backup_destination" {
  value = module.db_backup.destination_uri
}

output "backup_alarm_name" {
  value = module.db_backup.alarm_name
}

# Same contract as regulait-dev-app's output, so infra/scripts/install-pg-backup.sh
# works unchanged with ENV_DIR=infra/environments/demo-host/host. Values quoted
# because pg-backup.sh bash-sources the file (see regulait-dev-app/outputs.tf).
output "backup_env_file" {
  value = join("\n", [
    "# Generated by terraform (infra/environments/demo-host/host). Do not hand-edit.",
    "REGULAIT_BACKUP_BUCKET=\"${module.db_backup.bucket}\"",
    "REGULAIT_BACKUP_PREFIX=\"${module.db_backup.prefix}\"",
    "REGULAIT_BACKUP_REGION=\"${local.region}\"",
    "REGULAIT_BACKUP_ENABLED=\"1\"",
    "REGULAIT_BACKUP_ONCALENDAR=\"${var.backup_oncalendar}\"",
    "REGULAIT_BACKUP_METRIC_NAMESPACE=\"${module.db_backup.metric_namespace}\"",
    "REGULAIT_BACKUP_METRIC_NAME=\"${module.db_backup.metric_name}\"",
    "REGULAIT_BACKUP_METRIC_TARGET=\"${module.db_backup.metric_dimension_target}\"",
    "",
  ])
}

output "power_schedule" {
  value = module.power_schedule.window_summary
}
