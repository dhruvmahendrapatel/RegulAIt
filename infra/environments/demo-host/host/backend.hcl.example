# Write ../host/backend.hcl (git-ignored) from the break-glass baseline's output:
#   terraform -chdir=infra/environments/demo-host/baseline output -raw host_backend_hcl
# The state lives in the demo-host account, so the deployer never needs the
# management account. Shape:
bucket         = "regulait-demo-host-tfstate-<host-account-id>"
key            = "demo-host/host/terraform.tfstate"
dynamodb_table = "regulait-demo-host-tfstate-lock"
kms_key_id     = "<kms key arn from the baseline output>"
region         = "<aws-region>"
encrypt        = true
profile        = "regulait-demo-host"
