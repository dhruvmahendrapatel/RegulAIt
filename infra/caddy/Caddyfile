# RegulAIt — the public TLS terminator (ADR-0029).
#
# Caddy fronts the gateway and terminates TLS with a real, browser-trusted
# Let's Encrypt certificate for the hostname this deployment is reached at.
# (The sandbox executor does NOT come through here: it has its own internal
# front on the `engines` network, ./executor-front.Caddyfile.)
#
# The hostname is whatever REGULAIT_TLS_HOST names: a real domain, or for a
# box with only a public IP a free wildcard-DNS name such as
# `<a-b-c-d>.sslip.io`, which resolves to a.b.c.d (a real, publicly resolvable
# A record, which is all the ACME HTTP-01 challenge needs).
#
# Everything environment-specific is an env placeholder, so THIS file is the
# file that runs everywhere — box, laptop, and the local proof — and only the
# variables differ:
#
#   REGULAIT_TLS_HOST             site address   REQUIRED in practice; the default
#                                                is a `.invalid` placeholder that
#                                                never resolves, so an unset host
#                                                fails visibly (scripts/install.sh
#                                                writes it from --domain)
#   REGULAIT_TLS_UPSTREAM         proxy target   default gateway:3000 (compose DNS)
#   REGULAIT_TLS_EMAIL_DIRECTIVE  ACME contact   default empty (allowed)
#   REGULAIT_TLS_ISSUER           issuer         default EMPTY = real ACME /
#                                                Let's Encrypt. The local-proof
#                                                override sets it to
#                                                `tls internal` so a laptop or CI
#                                                box uses Caddy's own local CA and
#                                                NEVER calls Let's Encrypt (a
#                                                failed challenge from the wrong
#                                                host burns LE's failed-validation
#                                                rate limit).
#
#   Caveat, stated plainly: a hostname derived from a public IP changes when the
#   IP does, and Caddy then issues a brand-new certificate. Pin the address (an
#   elastic IP, ADR-0032) or use a real domain. See docs/ops/TLS.md.
{
	# Optional ACME account contact (expiry-warning mail). Empty by default so no
	# personal address is baked into the repo — Let's Encrypt accepts an account
	# with no contact. To set one, export
	#   REGULAIT_TLS_EMAIL_DIRECTIVE="email ops@example.com"
	{$REGULAIT_TLS_EMAIL_DIRECTIVE:}
}

# The shared headers and routes (./routes.Caddyfile, mounted beside this file).
import routes.Caddyfile

{$REGULAIT_TLS_HOST:set-regulait-tls-host.invalid} {
	# Empty by default → Caddy's default automatic HTTPS (Let's Encrypt, with
	# ZeroSSL as fallback). Set to `tls internal` for a local self-signed proof.
	{$REGULAIT_TLS_ISSUER:}

	# --- security headers ------------------------------------------------------
	# HSTS is NOT set here — but read the next paragraph before concluding it
	# is off, because for a while this comment was simply wrong.
	#
	# What it used to say: "HSTS is deliberately OFF (ADR-0029)", on the
	# grounds that this hostname is derived from an EC2 public IP that can
	# change on stop/start, and that HSTS is a browser-side, host-scoped,
	# NON-REVOCABLE commitment with no server-side undo before max-age
	# expires. All true. What it missed is that Caddy abstaining does not
	# make HSTS off: since ADR-0031 the GATEWAY behind this proxy had been
	# adding `max-age=31536000; includeSubDomains` to every secure response,
	# so the deployed box announced a one-year pin the whole time the ADR
	# argued it must not.
	#
	# Resolved by the ADR-0029 amendment of 2026-08-01: the GATEWAY is the
	# single owner of this header, because the gateway is what ships (into
	# BYOC / air-gapped installs that terminate TLS on someone else's proxy,
	# where no Caddyfile of ours exists) while this file is only our dev
	# stack. Since ADR-0181 its default is `max-age=31536000` (one year)
	# with NO includeSubDomains and NO preload, configurable per deployment
	# via the gateway's REGULAIT_HSTS env var. See apps/gateway/src/hsts.ts.
	# The dev box's compose override (infra/modules/app-instance/
	# user-data.sh.tftpl) sets REGULAIT_HSTS=max-age=86400, because this
	# sslip.io name can change hands on a stop/start.
	#
	# So: do NOT add a Strict-Transport-Security directive here. Two layers
	# setting it is exactly the defect that was fixed. Change the gateway's
	# REGULAIT_HSTS instead — and raise the dev box's max-age only once a
	# stable real domain replaces this sslip.io name.
	import regulait_headers

	# --- routes ----------------------------------------------------------------
	# The /idp allow-list and the gateway proxy live in ./routes.Caddyfile, shared
	# with the `tunnel` front (./tunnel.Caddyfile) so both doors route the same way.
	# This front IS the TLS endpoint, so the socket peer is the client and the
	# scheme is https (port 80 only redirects). Caddy would set X-Forwarded-Proto
	# and X-Forwarded-Host to exactly these values itself; they are spelled out so
	# the two fronts cannot differ.
	import regulait_routes {remote_host} https

	# Access log to stdout, so `docker compose logs caddy` is the one place to look.
	log {
		output stdout
		format console
	}
}

# Plain HTTP on :80 needs no stanza here: for a site address with an explicit
# hostname Caddy automatically serves the ACME HTTP-01 challenge on :80 and
# 308-redirects everything else to HTTPS. :80 must therefore stay open in the
# security group or both issuance and renewal fail.
