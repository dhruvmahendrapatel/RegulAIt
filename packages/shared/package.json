{
  "name": "@regulait/shared",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser-governance": {
      "types": "./dist/browser-governance/index.d.ts",
      "default": "./dist/browser-governance/index.js"
    },
    "./browser-governance/constants": {
      "types": "./dist/browser-governance/constants.d.ts",
      "default": "./dist/browser-governance/constants.js"
    },
    "./dlp-secret-re2": {
      "types": "./dist/dlp-secret-re2.d.ts",
      "default": "./dist/dlp-secret-re2.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arizeai/openinference-genai": "0.4.3",
    "@arizeai/openinference-semantic-conventions": "2.17.0",
    "@cyclonedx/cyclonedx-library": "10.5.1",
    "@humanwhocodes/momoa": "3.3.13",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bignumber.js": "11.1.5",
    "canonicalize": "5.1.0",
    "csv-stringify": "6.9.0",
    "fast-xml-parser": "5.12.1",
    "fflate": "0.8.3",
    "re2js": "2.10.0",
    "rfc6902": "5.5.0",
    "simple-statistics": "7.12.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "vitest": "^4.1.11"
  }
}
