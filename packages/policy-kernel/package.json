{
  "name": "@regulait/policy-kernel",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./actor": {
      "types": "./dist/actor.d.ts",
      "default": "./dist/actor.js"
    },
    "./abac": {
      "types": "./dist/abac.d.ts",
      "default": "./dist/abac.js"
    },
    "./rate-limit-cedar": {
      "types": "./dist/rate-limit-cedar.d.ts",
      "default": "./dist/rate-limit-cedar.js"
    },
    "./approval-rule-cedar": {
      "types": "./dist/approval-rule-cedar.d.ts",
      "default": "./dist/approval-rule-cedar.js"
    },
    "./resource-approval-rule-cedar": {
      "types": "./dist/resource-approval-rule-cedar.d.ts",
      "default": "./dist/resource-approval-rule-cedar.js"
    },
    "./detection-cedar": {
      "types": "./dist/detection-cedar.d.ts",
      "default": "./dist/detection-cedar.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.15.0"
  }
}
