# ADR-0360 §4: check the update spool hourly, spread over the fleet.
# Named apart from its service (the repo's basename-collision guard), so Unit= names the service explicitly.
[Unit]
Description=RegulAIt endpoint agent self-update check

[Timer]
OnBootSec=15min
OnUnitActiveSec=1h
RandomizedDelaySec=30min
Unit=regulait-agent-update.service

[Install]
WantedBy=timers.target
