{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "RegulAIt chart values (ADR-0304)",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "version", "image", "secrets"],
  "properties": {
    "mode": { "type": "string", "enum": ["byoc", "air_gapped"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "allowedRegistries": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 16 }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$" },
        "dataKeyKey": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" },
        "databaseUrlKey": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" },
        "bootstrapTokenKey": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
      }
    },
    "installSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": { "type": "string" },
        "size": { "type": "string" },
        "storageClassName": { "type": "string" }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "databaseCIDRs": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
        "allowedCIDRs": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "allowPublicEgress": { "type": "boolean" }
      }
    },
    "ingressFrom": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "namespaceSelector": { "type": "object" }, "podSelector": { "type": "object" } }
      }
    },
    "resources": { "type": "object" },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60 },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "digest": { "type": "string" }
          }
        }
      }
    }
  }
}
